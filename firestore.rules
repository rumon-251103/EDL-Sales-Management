rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return signedIn() && myProfile().role == 'super_admin' && myProfile().active == true;
    }
    function isAdmin() {
      return signedIn() && (myProfile().role == 'super_admin' || myProfile().role == 'admin') && myProfile().active == true;
    }
    function isDeliveryMan() {
      return signedIn() && myProfile().role == 'delivery_man' && myProfile().active == true;
    }

    // Login lookup: exact document reads only; listing the directory is prohibited.
    // Documents contain User ID -> Firebase Auth email mapping and should not contain passwords.
    match /loginDirectory/{userKey} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['authEmail', 'uid', 'active', 'userId']);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.role == 'delivery_man');
      allow update: if isSuperAdmin()
        || (isAdmin() && resource.data.role == 'delivery_man'
            && request.resource.data.role == 'delivery_man');
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.role == 'delivery_man' && resource.data.legacyPending == true);
    }

    match /mios/{mioId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (isDeliveryMan() && resource.data.deliveryManId == myProfile().id);
      allow create: if isDeliveryMan()
        && request.resource.data.deliveryManId == myProfile().id
        && request.resource.data.status == 'Pending'
        && request.resource.data.mioId in myProfile().assignedMioIds;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /system/{systemId} {
      allow read, write: if isSuperAdmin();
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
